{
  "name": "pods-control-development",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm install --prefix extension",
    "dev": "npm --prefix extension run dev",
    "build": "npm --prefix extension run build",
    "publish": "npm --prefix extension run publish --",
    "pull-contributions": "cd extension && npx @raycast/api@latest pull-contributions",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "type-check": "tsc --noEmit && npm --prefix extension run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --config eslint.config.js tests extension/src && npm --prefix extension run lint",
    "lint:fix": "eslint --config eslint.config.js --fix tests extension/src && npm --prefix extension run lint:fix"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.13.0",
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.10",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
